{
  "description": "Lifecycle hooks for the Codex 大肥鱼 desktop companion.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/codex-pet.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex-pet.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
